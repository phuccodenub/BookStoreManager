                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('customerToken', r.data.accessToken);",
                  "pm.environment.set('customerRefreshToken', r.data.refreshToken);",
                  "pm.environment.set('accessToken', r.data.accessToken);",
                  "pm.environment.set('refreshToken', r.data.refreshToken);"
                ]
              }
            }
