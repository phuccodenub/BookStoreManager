{
  "info": {
    "name": "BookStoreManager API (Full)",
    "description": "Complete Postman collection generated from backend routes. Includes uploads and payment webhook.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"User Test\",\n  \"email\": \"usertest@example.com\",\n  \"phone\": \"0909000001\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "POST /api/auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('adminToken', r.data.accessToken);",
                  "pm.environment.set('adminRefreshToken', r.data.refreshToken);",
                  "pm.environment.set('accessToken', r.data.accessToken);",
                  "pm.environment.set('refreshToken', r.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@bookstore.com\",\n  \"password\": \"Password123!\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST /api/auth/login (staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.environment.set('staffToken', r.data.accessToken);",
                  "pm.environment.set('staffRefreshToken', r.data.refreshToken);"
