generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum Role {
  customer
  staff
  admin
}

enum UserStatus {
  active
  locked
}

enum BookStatus {
  active
  out_of_stock
  discontinued
}

enum OrderStatus {
  pending
  confirmed
  packing
  shipping
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  cod
  online
}

enum VoucherType {
  percent
  fixed
}

enum InventoryTxType {
  import
  export
  adjustment
  order_confirm
  order_cancel
}

enum ContactStatus {
  new
  in_progress
  resolved
}

// ─────────────────────────────── USERS ───────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(120)
  email        String     @unique @db.VarChar(255)
  phone        String?    @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  avatar       String?    @db.VarChar(500)
  role         Role       @default(customer)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  addresses             Address[]
  cart                  Cart?
  orders                Order[]
  reviews               Review[]
  wishlistItems         Wishlist[]
  refreshTokens         RefreshToken[]
  activityLogs          ActivityLog[]
  inventoryTransactions InventoryTransaction[] @relation("CreatedByUser")
  assignedContacts      Contact[]              @relation("AssignedStaff")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────── ADDRESSES ───────────────────────────

model Address {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  receiverName  String  @map("receiver_name") @db.VarChar(120)
  receiverPhone String  @map("receiver_phone") @db.VarChar(20)
  province      String  @db.VarChar(100)
  district      String  @db.VarChar(100)
  ward          String  @db.VarChar(100)
  detailAddress String  @map("detail_address") @db.VarChar(300)
  isDefault     Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── CATALOG ─────────────────────────────

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(120)
  slug        String  @unique @db.VarChar(150)
  description String? @db.Text
  parentId    String? @map("parent_id") @db.Uuid
  status      Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  books    Book[]

  @@map("categories")
}

model Author {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @db.VarChar(150)
  bio    String? @db.Text
  avatar String? @db.VarChar(500)
  status Boolean @default(true)

  books Book[]

  @@map("authors")
}

model Publisher {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(200)
  address String? @db.VarChar(300)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(255)
  status  Boolean @default(true)

  books Book[]

  @@map("publishers")
}

model Book {
  id              String     @id @default(uuid()) @db.Uuid
  title           String     @db.VarChar(300)
  slug            String     @unique @db.VarChar(350)
  isbn            String?    @unique @db.VarChar(20)
  description     String?    @db.Text
  coverImage      String?    @map("cover_image") @db.VarChar(500)
  publicationYear Int?       @map("publication_year")
  pageCount       Int?       @map("page_count")
  price           Decimal    @db.Decimal(12, 0)
  importPrice     Decimal?   @map("import_price") @db.Decimal(12, 0)
  stockQuantity   Int        @default(0) @map("stock_quantity")
  soldQuantity    Int        @default(0) @map("sold_quantity")
  categoryId      String?    @map("category_id") @db.Uuid
  authorId        String?    @map("author_id") @db.Uuid
  publisherId     String?    @map("publisher_id") @db.Uuid
  status          BookStatus @default(active)
  isFeatured      Boolean    @default(false) @map("is_featured")
  isNew           Boolean    @default(false) @map("is_new")
  isBestSeller    Boolean    @default(false) @map("is_best_seller")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author    Author?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publisher Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  images                BookImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  wishlistItems         Wishlist[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@map("books")
}

model BookImage {
  id        String @id @default(uuid()) @db.Uuid
  bookId    String @map("book_id") @db.Uuid
  imageUrl  String @map("image_url") @db.VarChar(500)
  sortOrder Int    @default(0) @map("sort_order")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("book_images")
}

// ─────────────────────────────── CART ────────────────────────────────

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id       String @id @default(uuid()) @db.Uuid
  cartId   String @map("cart_id") @db.Uuid
  bookId   String @map("book_id") @db.Uuid
  quantity Int    @default(1)
  selected Boolean @default(true)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@map("cart_items")
}

// ─────────────────────────────── WISHLIST ────────────────────────────

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("wishlists")
}

// ─────────────────────────────── VOUCHERS ────────────────────────────

model Voucher {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique @db.VarChar(50)
  type            VoucherType
  value           Decimal     @db.Decimal(12, 0)
  minOrderValue   Decimal?    @map("min_order_value") @db.Decimal(12, 0)
  maxDiscountValue Decimal?   @map("max_discount_value") @db.Decimal(12, 0)
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  usageLimit      Int         @default(0) @map("usage_limit")
  usedCount       Int         @default(0) @map("used_count")
  status          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")

  orders Order[]

  @@map("vouchers")
}

// ─────────────────────────────── ORDERS ──────────────────────────────

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderCode       String        @unique @map("order_code") @db.VarChar(30)
  userId          String        @map("user_id") @db.Uuid
  voucherId       String?       @map("voucher_id") @db.Uuid

  // Snapshot fields ------
  receiverName    String        @map("receiver_name") @db.VarChar(120)
  receiverPhone   String        @map("receiver_phone") @db.VarChar(20)
  addressSnapshot String        @map("address_snapshot") @db.Text

  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")
  orderStatus     OrderStatus   @default(pending) @map("order_status")

  subtotal        Decimal       @db.Decimal(14, 0)
  shippingFee     Decimal       @map("shipping_fee") @db.Decimal(12, 0)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 0)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 0)

  note            String?       @db.Text
  cancelledReason String?       @map("cancelled_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id])
  voucher Voucher?   @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  bookId           String  @map("book_id") @db.Uuid
  bookNameSnapshot String  @map("book_name_snapshot") @db.VarChar(300)
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 0)
  totalPrice       Decimal @map("total_price") @db.Decimal(14, 0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────── PAYMENTS ────────────────────────────

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @map("order_id") @db.Uuid
  provider        String        @db.VarChar(50)
  transactionCode String?       @map("transaction_code") @db.VarChar(100)
  amount          Decimal       @db.Decimal(14, 0)
  status          PaymentStatus @default(pending)
  paidAt          DateTime?     @map("paid_at")
  rawResponse     Json?         @map("raw_response")
  createdAt       DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────── REVIEWS ─────────────────────────────

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, orderId])
  @@index([bookId])
  @@map("reviews")
}

// ─────────────────────────────── INVENTORY ───────────────────────────

model InventoryTransaction {
  id            String         @id @default(uuid()) @db.Uuid
  bookId        String         @map("book_id") @db.Uuid
  type          InventoryTxType
  quantity      Int
  unitCost      Decimal?       @map("unit_cost") @db.Decimal(12, 0)
  referenceType String?        @map("reference_type") @db.VarChar(50)
  referenceId   String?        @map("reference_id") @db.Uuid
  note          String?        @db.Text
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")

  book    Book  @relation(fields: [bookId], references: [id])
  creator User? @relation("CreatedByUser", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@map("inventory_transactions")
}

// ─────────────────────────────── SETTINGS ───────────────────────────

model SystemConfig {
  id                  String   @id @default("default") @db.VarChar(40)
  storeName           String   @map("store_name") @db.VarChar(200)
  contactEmail        String?  @map("contact_email") @db.VarChar(255)
  contactPhone        String?  @map("contact_phone") @db.VarChar(20)
  contactAddress      String?  @map("contact_address") @db.VarChar(300)
  shippingFee         Decimal  @default(25000) @map("shipping_fee") @db.Decimal(12, 0)
  supportHours        String?  @map("support_hours") @db.VarChar(200)
  paymentProviderName String?  @map("payment_provider_name") @db.VarChar(120)
  paymentInstructions String?  @map("payment_instructions") @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
// ─────────────────────────────── BANNERS ─────────────────────────────

model Banner {
  id        String    @id @default(uuid()) @db.Uuid
  title     String    @db.VarChar(200)
  image     String    @db.VarChar(500)
  link      String?   @db.VarChar(500)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  status    Boolean   @default(true)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("banners")
}

// ─────────────────────────────── CONTACTS ────────────────────────────

model Contact {
  id           String        @id @default(uuid()) @db.Uuid
  customerName String        @map("customer_name") @db.VarChar(120)
  email        String        @db.VarChar(255)
  phone        String?       @db.VarChar(20)
  subject      String        @db.VarChar(200)
  content      String        @db.Text
  status       ContactStatus @default(new)
  assignedTo   String?       @map("assigned_to") @db.Uuid
  note         String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  assignedStaff User? @relation("AssignedStaff", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("contacts")
}

// ─────────────────────────────── ACTIVITY LOGS ───────────────────────

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

